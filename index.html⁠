                vinyl.classList.add('spin-paused');
                if (playIcon) playIcon.className = 'fa-solid fa-play';
                if (lyricPlayIcon) lyricPlayIcon.className = 'fa-solid fa-play';
                if (lyricPlayText) lyricPlayText.innerText = 'เล่นเพลง';
            }
        }

        function playYouTubeTrack() {
            if (ytPlayer && typeof ytPlayer.playVideo === 'function') {
                try {
                    ytPlayer.playVideo();
                } catch(e) {
                    console.log('Play triggered before ready');
                }
            }
        }

        function toggleAudioPlayback() {
            if (!ytPlayer || typeof ytPlayer.getPlayerState !== 'function') return;
            if (isPlayingAudio) {
                ytPlayer.pauseVideo();
            } else {
                ytPlayer.playVideo();
            }
        }

