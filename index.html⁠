        // Load YouTube IFrame API Script asynchronously
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

        window.onYouTubeIframeAPIReady = function() {
            ytPlayer = new YT.Player('yt-player', {
                height: '10',
                width: '10',
                videoId: 'OYPiXBIgvJ8',
                playerVars: {
                    'autoplay': 0,
                    'controls': 0,
                    'loop': 1,
                    'playlist': 'OYPiXBIgvJ8',
                    'playsinline': 1,
                    'modestbranding': 1
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange
                }
            });
        };

        function onPlayerReady(event) {
            isYtReady = true;
            // If user has already opened the curtain, start playback
            if (isCurtainOpened) {
                playYouTubeTrack();
            }
        }

        function onPlayerStateChange(event) {
            const vinyl = document.getElementById('vinyl-icon');
            const playIcon = document.getElementById('audio-icon-status');
            const lyricPlayIcon = document.getElementById('btn-lyric-play-icon');
            const lyricPlayText = document.getElementById('btn-lyric-play-text');

            if (event.data === YT.PlayerState.PLAYING) {
                isPlayingAudio = true;
                vinyl.classList.remove('spin-paused');
                if (playIcon) playIcon.className = 'fa-solid fa-pause';
                if (lyricPlayIcon) lyricPlayIcon.className = 'fa-solid fa-pause';
                if (lyricPlayText) lyricPlayText.innerText = 'หยุดเพลงชั่วคราว';
            } else {
