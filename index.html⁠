<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Happy Anniversary ❤️ ALEEN & NA</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Mitr:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;0,800;1,600&family=Sarabun:wght@300;400;600&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }
        body {
            font-family: 'Mitr', 'Sarabun', sans-serif;
            background-color: #07070d;
            color: #f1f5f9;
            overflow-x: hidden;
            user-select: none;
        }
        .font-serif-title {
            font-family: 'Playfair Display', serif;
        }
        .font-mono-code {
            font-family: 'Fira Code', monospace;
        }

        /* Projector Light Beam */
        .projector-beam {
            position: absolute;
            top: -200px;
            left: 50%;
            transform: translateX(-50%);
            width: 1000px;
            height: 1000px;
            background: radial-gradient(ellipse at 50% 0%, rgba(254, 205, 211, 0.18) 0%, rgba(244, 63, 94, 0.08) 35%, rgba(0, 0, 0, 0) 75%);
            pointer-events: none;
            z-index: 1;
            filter: blur(25px);
            animation: beamPulse 6s ease-in-out infinite alternate;
        }

        @keyframes beamPulse {
            0% { opacity: 0.7; transform: translateX(-50%) scale(0.98); }
            100% { opacity: 1; transform: translateX(-50%) scale(1.03); }
        }

        /* Electronic Theater Curtains */
        .curtain-container {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: flex;
            pointer-events: none;
            transition: opacity 1.2s ease;
        }
        .curtain-left, .curtain-right {
            width: 50%;
            height: 100%;
            background: linear-gradient(135deg, #180509 0%, #3f0914 30%, #1a0408 60%, #0d0205 100%);
            box-shadow: inset 0 0 50px rgba(0,0,0,0.9);
            transition: transform 2.2s cubic-bezier(0.77, 0, 0.175, 1);
            position: relative;
            pointer-events: auto;
        }
        .curtain-left::after, .curtain-right::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 100%;
            background: repeating-linear-gradient(90deg, transparent, transparent 35px, rgba(0,0,0,0.4) 35px, rgba(255, 180, 200, 0.06) 70px);
        }
        .curtain-open .curtain-left {
            transform: translateX(-105%);
        }
        .curtain-open .curtain-right {
            transform: translateX(105%);
        }

        /* Film Grain Effect */
        .film-dust {
            position: fixed;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 0);
            background-size: 32px 32px;
            opacity: 0.25;
            pointer-events: none;
            z-index: 2;
            animation: dustFloat 12s linear infinite;
        }
        @keyframes dustFloat {
            0% { transform: translateY(0); }
            100% { transform: translateY(-32px); }
        }

        /* Glassmorphism Card */
        .glass-card {
            background: rgba(22, 16, 29, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(244, 114, 182, 0.2);
            box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6), 0 0 25px rgba(244, 63, 94, 0.15);
        }

        /* Floating Particle Animations */
        .float-emoji {
            position: fixed;
            pointer-events: none;
            z-index: 999;
            font-size: 28px;
            animation: floatUpBurst 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
        }
        @keyframes floatUpBurst {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(0.6) rotate(0deg);
            }
            50% {
                opacity: 0.95;
                transform: translate(var(--tx), var(--ty)) scale(1.3) rotate(var(--rot));
            }
            100% {
                opacity: 0;
                transform: translate(var(--tx), calc(var(--ty) - 80px)) scale(1.5) rotate(calc(var(--rot) * 2));
            }
        }

        /* Spinning Vinyl */
        @keyframes spinSlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spin-vinyl {
            animation: spinSlow 7s linear infinite;
        }
        .spin-paused {
            animation-play-state: paused;
        }

        /* Equalizer Bar Animation */
        @keyframes eqBounce {
            0%, 100% { height: 4px; }
            50% { height: 22px; }
        }
        .eq-bar {
            width: 3px;
            background: #f43f5e;
            border-radius: 2px;
            animation: eqBounce 1s ease-in-out infinite alternate;
        }
        .eq-bar:nth-child(2) { animation-delay: 0.2s; background: #fb7185; }
        .eq-bar:nth-child(3) { animation-delay: 0.4s; background: #fda4af; }
        .eq-bar:nth-child(4) { animation-delay: 0.1s; background: #e11d48; }

        /* Shake animation for incorrect password */
        .shake-box {
            animation: shake 0.45s cubic-bezier(.36,.07,.19,.97) both;
        }
        @keyframes shake {
            10%, 90% { transform: translate3d(-2px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0a060d;
        }
        ::-webkit-scrollbar-thumb {
            background: #4a1525;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative selection:bg-rose-500 selection:text-white">

