        function syncLyricLoop() {
            if (!ytPlayer || typeof ytPlayer.getCurrentTime !== 'function') return;

            let currentTime = 0;
            try {
                currentTime = ytPlayer.getCurrentTime() || 0;
            } catch(e) {
                return;
            }

            // Update time display label
            const mins = Math.floor(currentTime / 60);
            const secs = Math.floor(currentTime % 60);
            const timeLabel = document.getElementById('audio-time-display');
            if (timeLabel) {
                timeLabel.innerText = `${mins}:${String(secs).padStart(2, '0')}`;
            }

            // Find matching lyric
            let foundIndex = -1;
            for (let i = PUN_LYRICS.length - 1; i >= 0; i--) {
                if (currentTime >= PUN_LYRICS[i].time) {
                    foundIndex = i;
                    break;
                }
            }

            if (foundIndex !== activeLyricIndex && foundIndex !== -1) {
                activeLyricIndex = foundIndex;

                // Update styling
                PUN_LYRICS.forEach((_, idx) => {
                    const row = document.getElementById(`lyric-line-${idx}`);
                    if (!row) return;
                    if (idx === activeLyricIndex) {
                        row.classList.add('active');
                        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        row.classList.remove('active');
                    }
                });
            }
        }
    </script>
</body>
</html>
