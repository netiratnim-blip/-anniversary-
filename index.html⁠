            const ty = Math.sin(angle) * distance - 30; // slightly upward
            const rot = (Math.random() * 60 - 30) + 'deg';

            el.style.left = (x - 14) + 'px';
            el.style.top = (y - 14) + 'px';
            el.style.setProperty('--tx', tx + 'px');
