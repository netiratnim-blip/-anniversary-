        const ANNIVERSARY_START_DATE = new Date('2026-08-12T00:00:00+07:00').getTime();

        function updateLiveAnniversaryCounter() {
            const now = new Date().getTime();
            let elapsed = now - ANNIVERSARY_START_DATE;

            // In case of slight clock difference, default to at least 3 months baseline
            if (elapsed < 0) elapsed = 92 * 24 * 60 * 60 * 1000;

            const days = Math.floor(elapsed / (1000 * 60 * 60 * 24));
            const hours = Math.floor((elapsed % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((elapsed % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((elapsed % (1000 * 60)) / 1000);

            const pad = (n) => String(n).padStart(2, '0');

            document.getElementById('counter-days').innerText = pad(days);
            document.getElementById('counter-hours').innerText = pad(hours);
            document.getElementById('counter-minutes').innerText = pad(minutes);
            document.getElementById('counter-seconds').innerText = pad(seconds);
        }
        setInterval(updateLiveAnniversaryCounter, 1000);
