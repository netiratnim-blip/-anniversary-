        function animateLovePercent() {
            const label = document.getElementById('love-percent');
            const bar = document.getElementById('love-progress-bar');
            let current = 1;
            const target = 1000;
            const duration = 12000; // 12 seconds
            const stepTime = 30;
            const increment = target / (duration / stepTime);

            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                const displayVal = Math.floor(current);
                label.innerText = displayVal + '%';
                bar.style.width = Math.min(100, (displayVal / 10)) + '%';
            }, stepTime);
        }

